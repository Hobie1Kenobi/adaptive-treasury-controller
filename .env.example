# Copy to .env and fill in. Never commit .env.
# Sandbox keys: https://sandbox.airwallex.com → Account → Developer → API keys.
# Leave these empty to run the whole demo in mock mode.

AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# Optional. Defaults to the sandbox host. Paths are appended under /api/v1.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# auto: sandbox when both keys are set, otherwise mock.
# mock: never call Airwallex, even if keys are present.
# sandbox: require keys and call the sandbox.
TREASURY_MODE=auto

# Planner. auto uses Anthropic when ANTHROPIC_API_KEY is set,
# otherwise an OpenAI-compatible server when OPENAI_BASE_URL is set,
# otherwise the deterministic fallback (no network).
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI-compatible chat completions, including Ollama:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

PORT=4317

# Operating book used for the reserve-floor story. Default 15500 so a sandbox
# wallet that already holds millions still shows the scripted shortfall.
# Payouts still execute on the live wallet. Set to off to use raw balances.
# There is no sandbox withdrawal simulation.
TREASURY_OPERATING_CAP=15500

# EUR SWIFT fee provision. Base is the observed sandbox fee (13.48). The pad
# is converted as well so an empty EUR balance is not short when the live fee
# is a few cents higher. The transfer response fee_amount is the amount posted.
SWIFT_FEE_EUR=13.48
SWIFT_FEE_PAD_EUR=1
